---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { Toaster } from '../components/ui/toaster';
import Navigation from '../components/Navigation';
import Breadcrumbs, { getBreadcrumbSchema } from '../components/Breadcrumbs';
import ConsultationCTA from '../components/ConsultationCTA';
import Footer from '../components/Footer';
import FloatingAdvisorCTA from '../components/FloatingAdvisorCTA';
import PreferredSourcesCTA from '../components/PreferredSourcesCTA.astro';

interface Props {
	showBreadcrumbs?: boolean;
	showChrome?: boolean;
	/** Visual breadcrumb bar. Schema still renders when showBreadcrumbs is true. */
	breadcrumbBar?: boolean;
}

const { showBreadcrumbs = true, showChrome = true, breadcrumbBar = true } = Astro.props;
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/$/, "") || "/";
const skipMarkdownAlternate = normalizedPath === "/privacy" || normalizedPath === "/404";
const markdownHref =
	normalizedPath === "/" ? "/markdown/index.md" : `/markdown${normalizedPath}.md`;
const schema = showChrome && showBreadcrumbs ? getBreadcrumbSchema(currentPath) : null;
const guideEntries = showChrome ? await getCollection('guides') : [];
const guides = [...guideEntries]
	.sort((a, b) => {
		const ao = a.data.order ?? Number.POSITIVE_INFINITY;
		const bo = b.data.order ?? Number.POSITIVE_INFINITY;
		if (ao !== bo) return ao - bo;
		return a.data.title.localeCompare(b.data.title);
	})
	.map((entry) => ({
		title: entry.data.title,
		href: `/guides/${entry.data.slug}`,
	}));
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		{import.meta.env.PROD && !skipMarkdownAlternate && (
			<link rel="alternate" type="text/markdown" href={markdownHref} />
		)}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script src="https://analytics.ahrefs.com/analytics.js" data-key="U5p3QWN6cwWml7hdiLpW7g" async></script>
		<script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>
		<slot name="head" />
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
	</head>
	<body>
		<div class="min-h-screen bg-background">
			{showChrome && <Navigation currentPath={currentPath} guides={guides} client:load />}
			<main>
				{showChrome && showBreadcrumbs && breadcrumbBar && <Breadcrumbs currentPath={currentPath} />}
				<div data-md-content>
					<slot />
				</div>
			</main>
			{showChrome && <PreferredSourcesCTA />}
			{showChrome && <ConsultationCTA client:load />}
			{showChrome && <Footer />}
			{showChrome && <FloatingAdvisorCTA client:load />}
		</div>
		<Toaster client:load />
	</body>
</html>
