---
import { absoluteSocialUrl, socialPreviewFor } from '../data/socialPreviews';
import Layout from '../layouts/Layout.astro';
import InvestorEligibilityContent from '../components/InvestorEligibilityContent';

const title = 'Argentina Golden Visa Investment Readiness | Argentina Residence Waitlist';
const description = "A private readiness check for Argentina's announced citizenship-by-investment terms. Government applications are not yet confirmed as open. Join the Argentina Residence waitlist for updates.";
const canonical = 'https://argentinaresidence.com/argentina-golden-visa-eligibility-checker';
const social = socialPreviewFor('/argentina-golden-visa-eligibility-checker');
const ogImage = absoluteSocialUrl(social);
const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Argentina Residence Investment Readiness Check",
  "description": "A private readiness check for Argentina's announced citizenship-by-investment terms. Not a government eligibility determination. Government applications are not yet confirmed as open.",
  "applicationCategory": "Immigration Tool",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Free signup for the Argentina Residence waitlist. Not a government application, government priority place, or approval."
  }
};
---

<Layout>
	<title slot="head">{title}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="website" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={title} />
	<meta slot="head" property="og:description" content={description} />
	<meta slot="head" property="og:url" content={canonical} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content={String(social.width)} />
	<meta slot="head" property="og:image:height" content={String(social.height)} />
	<meta slot="head" property="og:image:alt" content={social.alt} />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={title} />
	<meta slot="head" name="twitter:description" content={description} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<InvestorEligibilityContent client:load />
</Layout>
