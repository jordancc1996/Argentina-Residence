---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import IndexContent from '../components/pages/IndexContent';

const articles = await getCollection('articles');
const posts = [...articles]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((entry) => ({
    id: entry.data.id,
    slug: entry.data.slug,
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    date: entry.data.date,
    readTime: entry.data.readTime,
    category: entry.data.category,
    image: entry.data.image,
    imageAlt: entry.data.imageAlt,
  }));

const title = 'Argentina Golden Visa | See If You Qualify | Argentina Residence';
const socialTitle = 'Argentina Golden Visa | Explore Ahead of Launch | Argentina Residence';
const description = 'Explore the Argentina Golden Visa, including investment requirements, eligibility, costs, and the application process. See if you qualify.';
const socialDescription = 'Explore the Argentina Golden Visa, including expected investment requirements, eligibility, costs, and the application process ahead of the program’s launch.';
const canonical = 'https://argentinaresidence.com';
const socialUrl = 'https://argentinaresidence.com/';
const ogImage = 'https://argentinaresidence.com/argentina-golden-visa-explore-ahead-of-launch.webp';
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Argentina Residence",
      "url": "https://argentinaresidence.com",
      "logo": "https://argentinaresidence.com/og-image.jpg",
      "description": "A specialized advisory boutique facilitating strategic capital deployment and residency acquisition in Argentina",
      "sameAs": []
    },
    {
      "@type": "WebSite",
      "url": "https://argentinaresidence.com",
      "name": "Argentina Residence",
      "description": "Live and invest in South America's most dynamic economy",
      "publisher": {
        "@type": "Organization",
        "name": "Argentina Residence"
      }
    }
  ]
};
---

<Layout showBreadcrumbs={false}>
	<title slot="head">{title}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="website" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={socialTitle} />
	<meta slot="head" property="og:description" content={socialDescription} />
	<meta slot="head" property="og:url" content={socialUrl} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content="1024" />
	<meta slot="head" property="og:image:height" content="682" />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={socialTitle} />
	<meta slot="head" name="twitter:description" content={socialDescription} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<IndexContent client:load posts={posts} />
</Layout>
