---
import { absoluteSocialUrl, socialPreviewFor } from '../data/socialPreviews';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import IndexContent from '../components/pages/IndexContent';
import ScrollProgress from '../components/ScrollProgress';

const articles = await getCollection('articles');
const posts = [...articles]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((entry) => ({
    id: entry.data.id,
    slug: entry.data.slug,
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    date: entry.data.date,
    readTime: entry.data.readTime,
    category: entry.data.category,
    image: entry.data.image,
    imageAlt: entry.data.imageAlt,
  }));

const title = 'Argentina Citizenship by Investment | Join the Waitlist | Argentina Residence';
const socialTitle = title;
const description = 'Argentina Golden Visa: October 2, 2026 announced a $350,000 Treasury contribution or an $800,000 public-bond route. Applications are not confirmed open. Join the waitlist.';
const socialDescription = description;
const canonical = 'https://argentinaresidence.com';
const socialUrl = canonical;
const social = socialPreviewFor('/');
const ogImage = absoluteSocialUrl(social);
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Argentina Residence",
      "url": "https://argentinaresidence.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://argentinaresidence.com/argentina-residence-logo.svg",
        "width": 1156,
        "height": 60
      },
      "description": "Argentina Residence publishes Golden Visa information and keeps its own waitlist. It does not file Argentine government applications.",
      "sameAs": []
    },
    {
      "@type": "WebSite",
      "url": "https://argentinaresidence.com",
      "name": "Argentina Residence",
      "description": "Argentina Golden Visa the pathway should not be treated as an open application program. Argentina Residence keeps its own waitlist for program updates.",
      "publisher": {
        "@type": "Organization",
        "name": "Argentina Residence"
      }
    }
  ]
};
---

<Layout showBreadcrumbs={false}>
	<title slot="head">{title}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="website" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={socialTitle} />
	<meta slot="head" property="og:description" content={socialDescription} />
	<meta slot="head" property="og:url" content={socialUrl} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content={String(social.width)} />
	<meta slot="head" property="og:image:height" content={String(social.height)} />
	<meta slot="head" property="og:image:alt" content={social.alt} />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={socialTitle} />
	<meta slot="head" name="twitter:description" content={socialDescription} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<ScrollProgress client:load />
	<IndexContent client:load posts={posts} />
</Layout>
