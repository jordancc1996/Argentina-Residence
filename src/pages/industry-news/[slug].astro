---
import { absoluteSocialUrl, socialPreviewFor } from '../../data/socialPreviews';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndustryNewsArticleContent from '../../components/IndustryNewsArticleContent';
import ComparisonBlock from '../../components/ComparisonBlock';
import SupportingImage from '../../components/SupportingImage';
import DateMeta from '../../components/DateMeta.astro';
import { getRelatedEntries } from '../../data/relatedContent';
import { articleAuthor } from '../../data/editorial';
import { reviewDateFor } from '../../data/reviews';

export async function getStaticPaths() {
  const entries = await getCollection('industryNews');
  const ordered = [...entries].sort((a, b) => a.data.id - b.data.id);

  return ordered.map((article) => {
    const related = getRelatedEntries(article.data.slug, 3, article.data.relatedSlugs).map((entry) => ({
        id: entry.id,
        slug: entry.slug,
        href: entry.href,
        title: entry.title,
        summary: entry.excerpt,
        source: entry.source,
      }));

    return {
      params: { slug: article.data.slug },
      props: { article, related },
    };
  });
}

const { article, related } = Astro.props;
const { Content } = await render(article);
const data = article.data;

const title = `${data.title} | Argentina Residence`;
const description = data.summary;
const canonical = `https://argentinaresidence.com/industry-news/${data.slug}`;
const social = socialPreviewFor(`/industry-news/${data.slug}`);
const ogImage = absoluteSocialUrl(social);
const articleImage = ogImage;
const faqPath = `/industry-news/${data.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": data.title,
  "description": data.summary,
  "datePublished": data.publishedDate || data.date,
  "dateModified": data.lastUpdatedDate || data.publishedDate || data.date,
  "author": articleAuthor(),
  "publisher": {
    "@type": "Organization",
    "name": "Argentina Residence",
    "url": "https://argentinaresidence.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://argentinaresidence.com/argentina-residence-logo.svg",
      "width": 1156,
      "height": 60
    }
  },
  "image": articleImage,
  "url": canonical,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  }
};
---

<Layout>
	<title slot="head">{title}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="article" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={title} />
	<meta slot="head" property="og:description" content={description} />
	<meta slot="head" property="og:url" content={canonical} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content={String(social.width)} />
	<meta slot="head" property="og:image:height" content={String(social.height)} />
	<meta slot="head" property="og:image:alt" content={social.alt} />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={title} />
	<meta slot="head" name="twitter:description" content={description} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<IndustryNewsArticleContent
		client:load
		title={data.title}
		date={data.date}
		source={data.source}
		image={data.image}
		imageAlt={data.imageAlt}
		related={related}
		faqPath={faqPath}
		reviewedAt={reviewDateFor(`/industry-news/${data.slug}`)}
	>
		<DateMeta publishedDate={data.publishedDate || data.date} lastUpdatedDate={data.lastUpdatedDate} />
		<Content components={{ ComparisonBlock, SupportingImage }} />
	</IndustryNewsArticleContent>
</Layout>
