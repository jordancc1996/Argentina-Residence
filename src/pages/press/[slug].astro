---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DateMeta from '../../components/DateMeta.astro';
import EditorialByline from '../../components/EditorialByline';
import { articleAuthor } from '../../data/editorial';
import { publishedPressReleases } from '../../data/pressReleases';
import { reviewDateFor } from '../../data/reviews';

export async function getStaticPaths() {
  const entries = await getCollection('pressReleases');
  return publishedPressReleases(entries).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const canonical = `https://argentinaresidence.com/press/${data.slug}`;
const title = data.seoTitle || `${data.title} | Argentina Residence`;
const description = data.seoDescription || data.summary;
const imageUrl = data.image ? `https://argentinaresidence.com${data.image}` : '';
const socialPath = data.image ? data.image.replace(/\.webp$/, '-og.webp') : '';
const ogImage = socialPath
  ? `https://argentinaresidence.com${socialPath}`
  : 'https://argentinaresidence.com/og-image.webp';
const ogWidth = socialPath ? '576' : '1200';
const ogHeight = socialPath ? '324' : '630';
const schema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: data.title,
  description,
  datePublished: data.date,
  ...(data.lastUpdatedDate && data.lastUpdatedDate !== data.date
    ? { dateModified: data.lastUpdatedDate }
    : {}),
  author: articleAuthor(),
  publisher: {
    "@type": "Organization",
    name: "Argentina Residence",
    url: "https://argentinaresidence.com",
    logo: {
      "@type": "ImageObject",
      url: "https://argentinaresidence.com/og-image.webp",
    },
  },
  ...(data.image ? { image: imageUrl } : {}),
  url: canonical,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical,
  },
};
---

<Layout>
	<title slot="head">{title}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="article" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={title} />
	<meta slot="head" property="og:description" content={description} />
	<meta slot="head" property="og:url" content={canonical} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content={ogWidth} />
	<meta slot="head" property="og:image:height" content={ogHeight} />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={title} />
	<meta slot="head" name="twitter:description" content={description} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<article class="section-padding">
		<div class="max-w-4xl mx-auto px-4 md:px-8">
			<a href="/press" class="inline-flex items-center gap-2 text-primary hover:underline mb-8">
				Back to Press Room
			</a>
			{data.image && (
				<img
					src={data.image}
					alt={data.imageAlt ?? ""}
					width="576"
					height="1024"
					class="mb-8 h-auto w-full max-w-[576px]"
				/>
			)}
			<h1 class="font-serif text-3xl md:text-4xl mb-6">{data.title}</h1>
			{data.subtitle && (
				<p class="font-serif text-lg md:text-xl leading-relaxed text-text-secondary mb-6">{data.subtitle}</p>
			)}
			<DateMeta publishedDate={data.date} lastUpdatedDate={data.lastUpdatedDate} />
			<EditorialByline reviewedAt={reviewDateFor(`/press/${data.slug}`)} client:load />
			<div class="prose prose-lg max-w-none mt-8 prose-headings:font-serif prose-headings:text-foreground prose-p:text-text-secondary prose-p:leading-relaxed prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-strong:text-foreground prose-strong:font-semibold prose-ul:text-text-secondary prose-li:text-text-secondary prose-h2:text-5xl prose-h2:mt-12 prose-h2:mb-6 prose-h3:text-4xl prose-h3:mt-8 prose-h3:mb-4">
				<Content />
			</div>
		</div>
	</article>
</Layout>
