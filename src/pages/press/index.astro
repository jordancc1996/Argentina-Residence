---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DateMeta from '../../components/DateMeta.astro';
import { publishedPressReleases } from '../../data/pressReleases';

const entries = await getCollection('pressReleases');
const releases = publishedPressReleases(entries).map((entry) => ({
  slug: entry.data.slug,
  title: entry.data.title,
  date: entry.data.date,
  lastUpdatedDate: entry.data.lastUpdatedDate,
  summary: entry.data.summary,
}));

const title = 'Press Room | Argentina Residence';
const description = 'Official news, announcements, and press releases from Argentina Residence.';
const canonical = 'https://argentinaresidence.com/press';
const ogImage = 'https://argentinaresidence.com/og-image.webp';
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Argentina Residence Press Room",
  description,
  url: canonical,
  publisher: {
    "@type": "Organization",
    name: "Argentina Residence",
  },
  ...(releases.length > 0
    ? {
        mainEntity: {
          "@type": "ItemList",
          itemListElement: releases.map((release, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: release.title,
            url: `https://argentinaresidence.com/press/${release.slug}`,
          })),
        },
      }
    : {}),
};
---

<Layout>
	<title slot="head">{title}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="website" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={title} />
	<meta slot="head" property="og:description" content={description} />
	<meta slot="head" property="og:url" content={canonical} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content="1200" />
	<meta slot="head" property="og:image:height" content="630" />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={title} />
	<meta slot="head" name="twitter:description" content={description} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<section class="section-padding">
		<div class="max-w-4xl mx-auto px-4 md:px-8">
			<p class="text-[0.7rem] uppercase tracking-[0.16em] text-muted-foreground mb-4">Press Room</p>
			<h1 class="font-serif text-3xl md:text-4xl mb-6">Argentina Residence Press Room</h1>
			<p class="text-base leading-relaxed text-muted-foreground mb-10 max-w-2xl">
				Official news, announcements, and press releases from Argentina Residence.
			</p>
			{releases.length === 0 ? (
				<p class="border-t border-border pt-8 text-muted-foreground">No press releases have been published.</p>
			) : (
				<div class="border-t border-border">
					{releases.map((release) => (
						<article class="border-b border-border py-8">
							<h2 class="font-serif text-2xl mb-3">
								<a href={`/press/${release.slug}`} class="text-foreground hover:text-primary transition-colors duration-150 ease-out">
									{release.title}
								</a>
							</h2>
							<DateMeta publishedDate={release.date} lastUpdatedDate={release.lastUpdatedDate} />
							<p class="text-muted-foreground leading-relaxed">{release.summary}</p>
						</article>
					))}
				</div>
			)}
		</div>
	</section>
</Layout>
