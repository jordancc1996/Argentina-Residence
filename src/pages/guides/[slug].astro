---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GuideArticleContent from '../../components/GuideArticleContent';
import ComparisonBlock from '../../components/ComparisonBlock';
import ComparisonTable from '../../components/ComparisonTable';
import KeyFactsTable from '../../components/KeyFactsTable';
import ChecklistCard from '../../components/ChecklistCard';
import ProcessSteps from '../../components/ProcessSteps';
import InquiryCard from '../../components/InquiryCard';
import NewsletterSignup from '../../components/NewsletterSignupMdx.astro';
import { DueDiligenceReviewGroups, BusinessSaleTimingSteps } from '../../components/guideBlocks';
import { getRelatedGuides } from '../../data/relatedGuides';

// PLACEHOLDER IMAGE — replace with a real photo for due diligence process once provided
// PLACEHOLDER IMAGE — replace with a real photo for business sale/startup exits once provided
// PLACEHOLDER IMAGE — replace with a real photo for US visa backlog timing once provided
// PLACEHOLDER IMAGE — replace with a real photo for vs. Caribbean citizenship comparison once provided
// PLACEHOLDER IMAGE — replace with a real photo for vs. Greece Golden Visa comparison once provided
// PLACEHOLDER IMAGE — replace with a real photo for vs. Turkey Citizenship by Investment comparison once provided
// PLACEHOLDER IMAGE — replace with a real photo for vs. Paraguay Investor Pass comparison once provided
// PLACEHOLDER IMAGE — replace with a real photo for vs. Panama comparison once provided
import placeholderGuideHero from '../../assets/hero-buenos-aires-night.jpg';

const PLACEHOLDER_HEROES: Record<string, typeof placeholderGuideHero> = {
  'argentina-citizenship-investment-due-diligence': placeholderGuideHero,
  'argentina-citizenship-investment-business-sale': placeholderGuideHero,
  'argentina-citizenship-investment-us-visa-backlog': placeholderGuideHero,
  'argentina-cbi-vs-caribbean-citizenship': placeholderGuideHero,
  'argentina-citizenship-investment-vs-greece-golden-visa': placeholderGuideHero,
  'argentina-citizenship-investment-vs-turkey': placeholderGuideHero,
  'argentina-citizenship-investment-vs-paraguay': placeholderGuideHero,
  'argentina-citizenship-investment-vs-panama': placeholderGuideHero,
};

export async function getStaticPaths() {
  const dedicatedGuideSlugs = new Set([
    'argentina-golden-visa-program',
    'argentina-real-estate-investment',
  ]);
  const entries = await getCollection('guides');
  return entries
    .filter((entry) => !dedicatedGuideSlugs.has(entry.data.slug) && (entry.body ?? '').trim().length > 0)
    .map((guide) => ({
      params: { slug: guide.data.slug },
      props: { guide },
    }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const data = guide.data;

const pageTitle = data.seoTitle || data.title;
const metaTitle = `${pageTitle} | Argentina Residence`;
const description = data.seoDescription || '';
const canonical = `https://argentinaresidence.com/guides/${data.slug}`;
const ogImage = 'https://argentinaresidence.com/og-image.jpg';
const heroImage = PLACEHOLDER_HEROES[data.slug] ?? placeholderGuideHero;
const published = data.datePublished || data.dateModified || '2026-08-19';

const related = getRelatedGuides(data.slug, 5);
const showBottomInquiryCard = !/<InquiryCard\b/.test(guide.body ?? '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description,
  author: {
    '@type': 'Organization',
    name: 'Argentina Residence',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Argentina Residence',
    url: 'https://argentinaresidence.com',
  },
  datePublished: published,
  dateModified: data.dateModified || published,
  url: canonical,
};
---

<Layout>
	<title slot="head">{metaTitle}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="website" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={metaTitle} />
	<meta slot="head" property="og:description" content={description} />
	<meta slot="head" property="og:url" content={canonical} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content="1200" />
	<meta slot="head" property="og:image:height" content="630" />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={metaTitle} />
	<meta slot="head" name="twitter:description" content={description} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<GuideArticleContent
		client:load
		heroTitle={data.heroTitle || data.title}
		subtitle={data.subtitle}
		backgroundImage={heroImage}
		imageAlt="Buenos Aires at night"
		statusBanner={data.statusBanner}
		related={related}
		showBottomInquiryCard={showBottomInquiryCard}
	>
		<Content components={{ ComparisonBlock, ComparisonTable, KeyFactsTable, ChecklistCard, ProcessSteps, InquiryCard, NewsletterSignup, DueDiligenceReviewGroups, BusinessSaleTimingSteps }} />
	</GuideArticleContent>
</Layout>
