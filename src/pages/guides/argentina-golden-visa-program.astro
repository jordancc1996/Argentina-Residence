---
import Layout from '../../layouts/Layout.astro';
import GoldenVisaProgramContent from '../../components/GoldenVisaProgramContent';
import DateMeta from '../../components/DateMeta.astro';
import { articleAuthor } from '../../data/editorial';

const title = "Argentina Golden Visa 2026 | Citizenship by Investment Guide";
const description = "Decree 524/2025 does not set $500,000 or $1,000,000. Those reported figures are not enacted requirements. APCI is not processing files.";
const canonical = 'https://argentinaresidence.com/guides/argentina-golden-visa-program';
const ogImage = 'https://argentinaresidence.com/og-image.webp';
const publishedDate = "2026-01-22";
const lastUpdatedDate = "2026-08-19";
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Argentina's New Golden Visa: The 2026 Investor Guide",
  "description": "Complete guide to Argentina's proposed Golden Visa program. APCI has not published operational regulations or opened applications.",
  "author": articleAuthor(),
  "publisher": {
    "@type": "Organization",
    "name": "Argentina Residence",
    "url": "https://argentinaresidence.com"
  },
  "datePublished": publishedDate,
  "dateModified": lastUpdatedDate
};
---

<Layout>
	<title slot="head">{title}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="website" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={title} />
	<meta slot="head" property="og:description" content={description} />
	<meta slot="head" property="og:url" content={canonical} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content="1200" />
	<meta slot="head" property="og:image:height" content="630" />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={title} />
	<meta slot="head" name="twitter:description" content={description} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<GoldenVisaProgramContent client:load>
		<DateMeta publishedDate={publishedDate} lastUpdatedDate={lastUpdatedDate} />
	</GoldenVisaProgramContent>
</Layout>
