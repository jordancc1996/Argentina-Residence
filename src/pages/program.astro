---
import { absoluteSocialUrl, socialPreviewFor } from '../data/socialPreviews';
import Layout from '../layouts/Layout.astro';
import ProgramContent from '../components/ProgramContent';

const title = 'Argentina Citizenship by Investment Program Overview | Argentina Residence';
const description = 'Argentina Citizenship by Investment Program Overview: October 2, 2026 announced a $350,000 Treasury contribution or an $800,000 public-bond route. Government applications are not yet confirmed as open.';
const canonical = 'https://argentinaresidence.com/program';
const social = socialPreviewFor('/program');
const ogImage = absoluteSocialUrl(social);
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Argentina Citizenship by Investment Program Overview",
  "url": canonical,
  "description": "Overview of Argentina's anticipated citizenship-by-investment framework. The pathway should not be treated as an open application program. The Argentina Residence waitlist is for updates only and is not a government application.",
  "publisher": {
    "@type": "Organization",
    "name": "Argentina Residence",
    "url": "https://argentinaresidence.com"
  },
  "about": {
    "@type": "Thing",
    "name": "Argentina citizenship by investment",
    "description": "Anticipated citizenship-by-investment framework. The pathway should not be treated as an open application program."
  }
};
---

<Layout showBreadcrumbs={false}>
	<title slot="head">{title}</title>
	<meta slot="head" name="description" content={description} />
	<link slot="head" rel="canonical" href={canonical} />
	<meta slot="head" name="robots" content="index, follow" />
	<meta slot="head" property="og:type" content="website" />
	<meta slot="head" property="og:site_name" content="Argentina Residence" />
	<meta slot="head" property="og:title" content={title} />
	<meta slot="head" property="og:description" content={description} />
	<meta slot="head" property="og:url" content={canonical} />
	<meta slot="head" property="og:image" content={ogImage} />
	<meta slot="head" property="og:image:width" content={String(social.width)} />
	<meta slot="head" property="og:image:height" content={String(social.height)} />
	<meta slot="head" property="og:image:alt" content={social.alt} />
	<meta slot="head" property="og:locale" content="en_US" />
	<meta slot="head" name="twitter:card" content="summary_large_image" />
	<meta slot="head" name="twitter:title" content={title} />
	<meta slot="head" name="twitter:description" content={description} />
	<meta slot="head" name="twitter:image" content={ogImage} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<ProgramContent client:load />
</Layout>
