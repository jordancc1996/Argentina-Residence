---
const siteName = "Argentina Residence";
---

<section class="w-full py-12 md:py-16 px-6 md:px-10 border-t border-border bg-background">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-serif text-xl md:text-2xl text-editorial mb-3">
      Follow {siteName} on Google
    </h2>
    <p class="text-sm text-text-secondary mb-6 tracking-wide leading-relaxed max-w-2xl">
      Add {siteName} as a preferred source to see more of our research, guides, and analysis in Google Search.
    </p>
    <div google-add-preferred-source-btn data-lang="en" data-theme="light"></div>
  </div>
</section>
